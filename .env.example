# Copiar a .env y llenar. El archivo .env NUNCA se sube al repositorio.

# Dónde está el conjunto de datos en esta máquina. El conjunto no se versiona: ver data/README.md
GLUCY_RUTA_DATOS=

# Dónde se dejan los artefactos entrenados y su JSON de métricas.
GLUCY_RUTA_ARTEFACTOS=artifacts

# Semilla, para que una corrida se pueda repetir. Un resultado que no se puede repetir no
# sirve para un trabajo que se va a evaluar.
GLUCY_SEMILLA=42
